module AsyncRT {
  explicit module Common {
    header "Common.h"
    header "Common/common.h"
    header "Common/Optional.h"
    header "Common/Pointer.h"
    header "Common/Plugin.h"
    header "Common/OFApplication+ExecutableIRI.h"
    export *
  }

  explicit module Core {
    header "Core.h"
    header "Core/AsyncUnit.h"
    header "Core/AsyncCompletionSource.h"
    header "Core/AsyncTask.h"
    header "Core/AsyncCoroutine.h"
    header "Core/AsyncScheduler.h"
    header "Core/AsyncTaskGroup.h"
    header "Core/AsyncChannel.h"
    header "Core/AsyncStreamTasks.h"
    header "Core/AsyncRuntime.h"
    header "Core/AsyncRuntimeInternal.h"
    export *
  }

  explicit module Application {
    explicit module Core {
      header "Application/Core.h"
      header "Application/Core/AsyncApplication.h"
      export *
    }

    explicit module Terminal {
      header "Application/Terminal.h"
      header "Application/Terminal/AsyncArgumentParser.h"
      export *
    }

    explicit module UI {
      header "Application/UI.h"
      header "Application/UI/AsyncUI.h"
      header "Application/UI/AsyncUIAction.h"
      header "Application/UI/AsyncUIApplication.h"
      header "Application/UI/AsyncUIAxisSize.h"
      header "Application/UI/AsyncUIBorderStyle.h"
      header "Application/UI/AsyncUIBox.h"
      header "Application/UI/AsyncUIBoxStyle.h"
      header "Application/UI/AsyncUIButton.h"
      header "Application/UI/AsyncUIClaySupport.h"
      header "Application/UI/AsyncUIColorValue.h"
      header "Application/UI/AsyncUIComponent.h"
      header "Application/UI/AsyncUIContent.h"
      header "Application/UI/AsyncUIContextMenu.h"
      header "Application/UI/AsyncUIContextMenuItem.h"
      header "Application/UI/AsyncUIControlColors.h"
      header "Application/UI/AsyncUIControlStyle.h"
      header "Application/UI/AsyncUIEdgeInsets.h"
      header "Application/UI/AsyncUIExceptions.h"
      header "Application/UI/AsyncUIGroup.h"
      header "Application/UI/AsyncUIInteraction.h"
      header "Application/UI/AsyncUIKeyedContent.h"
      header "Application/UI/AsyncUIPrimitives.h"
      header "Application/UI/AsyncUIRenderContext.h"
      header "Application/UI/AsyncUIStack.h"
      header "Application/UI/AsyncUIStackLayout.h"
      header "Application/UI/AsyncUIState.h"
      header "Application/UI/AsyncUIText.h"
      header "Application/UI/AsyncUITextField.h"
      header "Application/UI/AsyncUITextInputHandlers.h"
      header "Application/UI/AsyncUITextStyle.h"
      header "Application/UI/AsyncUIWindowConfiguration.h"
      header "Application/UI/Backend/AsyncUIBackend.h"
      header "Application/UI/Backend/AsyncUIInput.h"
      header "Application/UI/Backend/AsyncUIWindow.h"
      header "Application/UI/Backend/Window/AsyncUIHeadlessWindow.h"
      export *
    }
  }

  explicit module Networking {
    explicit module HTTP {
      header "Networking/HTTP.h"
      header "Networking/HTTP/AsyncHTTPClient.h"
      header "Networking/HTTP/AsyncHTTPServer.h"
      export *
    }
  }

  explicit module Database {
    header "Database.h"
    header "Database/AsyncDBConnection.h"
    header "Database/AsyncDBProvider.h"
    export *

    explicit module Provider {
      explicit module SQLite {
        header "Database/Providers/SQLite.h"
        header "Database/Providers/SQLite/AsyncDBSQLite.h"
        export *
      }
    }
  }
}
